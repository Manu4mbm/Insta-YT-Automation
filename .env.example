# ── Copy to .env (local) AND add the same values in Vercel → Project → Settings → Environment Variables.
# ── NEVER commit .env. NEVER paste these into chat.

# Brand (used in DMs, emails, receipts)
BRAND_NAME=            # e.g. Acme Studio
IG_HANDLE=             # your Instagram username, without @
APP_URL=               # your Vercel URL, e.g. https://acme-reels.vercel.app (no trailing slash)

# Instagram API with Instagram Login (see docs/META-SETUP.md)
IG_USER_ID=
IG_ACCESS_TOKEN=       # long-lived token (auto-refreshed by /api/cron/refresh-token)
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=  # any long random string; paste the same one in Meta → Webhooks
GRAPH_VERSION=v25.0
IG_API_HOST=graph.facebook.com   # graph.facebook.com = Unified login (new Meta apps); graph.instagram.com = old Instagram login

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protects all /api/cron and /api/admin routes — long random string (also stored in Supabase Vault as cron_secret)
CRON_SECRET=

# Optional: YouTube Shorts auto-upload (see docs/YOUTUBE.md)
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# Optional: paid guides with Razorpay payment links
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
PAY_BANK_DOMAINS=      # optional: bank alert email domains for the UPI-alert matcher (gmail/Code.gs)

# X (Twitter) OAuth 2.0 app — console.x.com
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn (developer app with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect").
# Redirect URL in the app: {APP_URL}/api/x/linkedin-callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_VERSION=202608      # Posts API version header (YYYYMM); bump yearly
# LINKEDIN_ORG_SCOPES=1        # only after Community Management API is approved (Company Page posting)
